# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL
# Development: http://localhost:3000 (optional local override)
# Production: https://helchang.com
SITE_URL=https://helchang.com
NEXT_PUBLIC_SITE_URL=https://helchang.com

# Candidate expansion: 100 = all eligible members (default); 0 = emergency off.
# Apply supabase/sql/dating_1on1_expansion_batches.sql before enabling on a new DB.
# Server-only; never expose a NEXT_PUBLIC override or enable by a URL parameter.
DATING_EXPANSION_PERCENT=100
